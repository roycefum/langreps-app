# Base URL of the language-tutor-api FastAPI server.
# A physical device (or the Expo dev client) can't reach your dev machine's
# `localhost` — use your machine's LAN IP instead (find it with
# `ipconfig getifaddr en0` on macOS). The simulator can use localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.80:8000
