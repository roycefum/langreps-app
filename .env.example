# Base URL of the language-tutor-api FastAPI server.
#
# For local development: a physical device (or the Expo dev client) can't
# reach your dev machine's `localhost` — use your machine's LAN IP instead
# (find it with `ipconfig getifaddr en0` on macOS). The simulator can use
# localhost.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.80:8000
#
# For builds meant to run outside your own network (e.g. Android testers),
# point this at the deployed Railway backend instead:
EXPO_PUBLIC_API_BASE_URL=https://web-production-662f9b.up.railway.app
